# Mindlock — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ─── Network ──────────────────────────────────────────────────────────────────
# Which Solana cluster to use: devnet | testnet | mainnet-beta
SOLANA_NETWORK=devnet

# ─── Quicknode RPC (Eitherway Side Track) ─────────────────────────────────────
# Get a free endpoint at https://www.quicknode.com/
# 1. Create account → New Endpoint → Solana → Devnet
# 2. Copy the HTTP Provider URL and WSS Provider URL below
#
# Benefits over public RPC:
#   • Unlimited getProgramAccounts (leaderboard fetches ~10x faster)
#   • <40ms median latency (public = ~200ms)
#   • Quicknode Streams for real-time charity wallet monitoring
#   • Qualifies for Eitherway/Quicknode hackathon side track
#
# Leave blank to fall back to public endpoints (still works, just slower).
QUICKNODE_DEVNET_URL=https://your-endpoint.solana-devnet.quiknode.pro/your-token/
QUICKNODE_DEVNET_WS_URL=wss://your-endpoint.solana-devnet.quiknode.pro/your-token/

# Mainnet (for production — leave blank during hackathon)
QUICKNODE_MAINNET_URL=
QUICKNODE_MAINNET_WS_URL=

# ─── Jupiter ──────────────────────────────────────────────────────────────────
# No API key needed — Jupiter Price API v6 is public.
# If you have a Jupiter Pro API key, add it here for higher rate limits:
# JUPITER_API_KEY=

# ─── Kamino ───────────────────────────────────────────────────────────────────
# No API key needed — Kamino's strategies API is public.

# ─── GoldRush (Covalent) ──────────────────────────────────────────────────────
# Get a free key at https://www.covalenthq.com/
# Used for: charity wallet transaction history in the Impact Dashboard
GOLDRUSH_API_KEY=cqt_rQ4jtvQHw89vMK8bJGDFkBBVj9Cm
